{
  "schema_version": "1.0",
  "arms": {
    "A": {
      "name": "Native",
      "model_capabilities": ["screenshot", "computer_use"],
      "verifier_packet_visible": false,
      "gate_enforced": false,
      "hidden_judge_visible": false,
      "description": "模型自己根据可见界面判断动作与任务是否完成。"
    },
    "B": {
      "name": "Passive Verifier",
      "model_capabilities": ["screenshot", "computer_use"],
      "verifier_packet_visible": true,
      "gate_enforced": false,
      "hidden_judge_visible": false,
      "description": "与 A 完全相同的视觉/行动能力；每个 checkpoint 后自动注入相同格式 verifier packet，但不阻止模型继续。"
    },
    "C": {
      "name": "Verifier + Gate",
      "model_capabilities": ["screenshot", "computer_use"],
      "verifier_packet_visible": true,
      "gate_enforced": true,
      "hidden_judge_visible": false,
      "description": "与 B 获得完全相同 verifier packet；另外执行冻结 gate policy。"
    }
  },
  "forbidden_for_all_models": [
    "direct_javascript_eval",
    "dom_inspection_tool",
    "verificationBench.hiddenJudge",
    "verificationBench.authoritativeState"
  ],
  "verifier_injection": {
    "trigger": "after every fixture business-action checkpoint and before accepting a final success claim",
    "source": "verificationBench.verifier()",
    "same_packet_for_B_and_C": true,
    "role": "environment_evidence",
    "must_not_add_advice": true
  },
  "gate_policy": {
    "pending": {
      "block_final_success": true,
      "block_new_irreversible_intent": true,
      "allow": ["wait", "reobserve"]
    },
    "failed": {
      "block_forward_success": true,
      "allow": ["safe_retry_if_task_recoverable", "report_failure", "handoff"]
    },
    "unchanged": {
      "block_forward_success": true,
      "allow": ["safe_retry_if_task_recoverable", "report_not_effected", "handoff"]
    },
    "uncertain": {
      "block_forward_success": true,
      "allow": ["wait", "reobserve", "handoff"]
    },
    "conflict": {
      "block_forward_success": true,
      "allow": ["reobserve", "replan", "handoff"]
    },
    "committed": {
      "block_duplicate_same_intent_when_duplicate_risk": true,
      "allow": ["continue", "final_success_if_task_postcondition_met"]
    }
  }
}
