{
  "schema_version": "0.1",
  "adapter_id": "profile-adapter",
  "adapter_version": "2",
  "workflow_id": "profile-submit",
  "site_version": "fixture-v2",
  "description": "资料提交任务的第二版适配器示例,故意改变提交前置条件用于兼容性测试",
  "state_rules": [
    {"id": "profile.empty", "when": {"form_state": "empty", "outcome_hint": null}},
    {"id": "profile.partial", "when": {"form_state": "partial", "outcome_hint": null}},
    {"id": "profile.complete", "when": {"form_state": "complete", "outcome_hint": null}}
  ],
  "operations": [
    {
      "name": "填写资料",
      "preconditions": ["profile.empty", "profile.partial"],
      "outputs": [{"name": "资料", "ref": "profile.form"}],
      "executor": "world_act"
    },
    {
      "name": "提交资料",
      "preconditions": ["profile.partial"],
      "inputs": [{"from": "填写资料.资料", "to": "提交资料.资料"}],
      "outputs": [{"name": "提交结果", "ref": "profile.result"}],
      "executor": "world_act"
    }
  ]
}
