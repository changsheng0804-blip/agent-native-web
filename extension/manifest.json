{
  "manifest_version": 3,
  "name": "智能体原生网页",
  "version": "1.0.0",
  "description": "实时将网页翻译成智能体可查询的结构化世界",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>", "file:///*"],
    "js": [
      "engine/scanner.js",
      "engine/occupancy.js",
      "engine/topology.js",
      "engine/semantics.js",
      "engine/visibility.js",
      "engine/query.js",
      "content/observer.js",
      "content/runtime.js",
      "content/overlay.js",
      "api/agent-world.js",
      "content/bootstrap.js"
    ],
    "css": [],
    "run_at": "document_idle"
  }],
  "action": {
    "default_popup": "扩展说明-popup.html",
    "default_title": "智能体原生网页"
  }
}
